// omarchy-cli retint — installed by ~/.config/omarchy/hooks/theme-set.d/50-aether-cli-retints
// (Aether extras). Follows the active Omarchy theme.
//
// Aether — fastfetch emblem & module palette
//
// Installed to ~/.config/fastfetch/config.jsonc by the Aether hook
// (extras/omarchy-cli-retints, wired into Omarchy's theme-set hook), so the
// emblem and key gradient follow the active theme.
//
// The emblem is inline art (logo type "data-raw") so it travels with the
// theme file: a pixel cloud traced from the theme's reference image — cyan
// rim along the top silhouettes (#00f0ff), a white frost body shading
// #f7fcff → #cde1ff, and the reference's grey shading mapped to periwinkle
// → violet (#5d9afa → #a855f7 → #7c3aed) at the base. The tagline row is
// distributed evenly across the cloud's full width. Module keys fade
// cyan → violet down the list.
//
// This config keeps the user@host title line (krxsh@aether). The Omarchy
// menu's About panel runs a separate config without it — see
// extras/about/aether-about.jsonc and the About override install-extras.sh
// wires into ~/.config/omarchy/extensions/omarchy-menu.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data-raw",
    "source": "\u001b[38;2;168;85;247m    ✦\u001b[0m                 \u001b[38;2;0;240;255m▄▄\u001b[38;2;0;240;255m\u001b[48;2;247;252;255m▀▀▀▀\u001b[38;2;0;240;255m▄▄\u001b[0m           \u001b[0m\n\u001b[0m               \u001b[38;2;0;240;255m\u001b[48;2;149;102;247m▀\u001b[38;2;0;240;255m\u001b[48;2;93;154;250m▀\u001b[38;2;247;252;255m████████\u001b[38;2;0;240;255m\u001b[48;2;247;252;255m▀▀\u001b[38;2;0;240;255m▄\u001b[0m        \u001b[0m\n\u001b[0m        \u001b[38;2;0;240;255m\u001b[48;2;149;102;247m▀\u001b[38;2;0;240;255m\u001b[48;2;168;85;247m▀\u001b[38;2;0;240;255m\u001b[48;2;149;102;247m▀▀\u001b[38;2;0;240;255m\u001b[48;2;93;154;250m▀▀▀\u001b[38;2;93;154;250m\u001b[48;2;247;252;255m▀\u001b[38;2;247;252;255m███████████\u001b[38;2;168;85;247m\u001b[48;2;247;252;255m▀\u001b[0m        \u001b[0m\n\u001b[0m     \u001b[38;2;0;240;255m▄\u001b[38;2;0;240;255m\u001b[48;2;230;241;255m▀▀\u001b[38;2;149;102;247m██\u001b[38;2;93;154;250m\u001b[48;2;230;241;255m▀\u001b[38;2;247;252;255m\u001b[48;2;230;241;255m▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀\u001b[38;2;0;240;255m\u001b[48;2;93;154;250m▀\u001b[38;2;0;240;255m▄▄▄\u001b[0m    \u001b[0m\n\u001b[0m  \u001b[38;2;0;240;255m▄\u001b[38;2;0;240;255m\u001b[48;2;230;241;255m▀▀\u001b[38;2;230;241;255m███████████████████████████\u001b[38;2;0;240;255m\u001b[48;2;230;241;255m▀▀\u001b[38;2;0;240;255m▄\u001b[0m \u001b[0m\n\u001b[0m \u001b[38;2;0;240;255m\u001b[48;2;93;154;250m▀\u001b[38;2;93;154;250m█\u001b[38;2;230;241;255m████████████████\u001b[38;2;230;241;255m\u001b[48;2;93;154;250m▀\u001b[38;2;230;241;255m██████████████\u001b[38;2;149;102;247m\u001b[48;2;93;154;250m▀\u001b[38;2;0;240;255m▄\u001b[0m\n\u001b[38;2;0;240;255m\u001b[48;2;124;58;237m▀\u001b[38;2;93;154;250m██\u001b[38;2;205;225;255m████████\u001b[38;2;93;154;250m█\u001b[38;2;205;225;255m\u001b[48;2;93;154;250m▀\u001b[38;2;205;225;255m█████\u001b[38;2;93;154;250m\u001b[48;2;205;225;255m▀\u001b[38;2;205;225;255m\u001b[48;2;93;154;250m▀\u001b[38;2;205;225;255m████████\u001b[38;2;205;225;255m\