# Aether — btop theme
# main_bg is empty so the terminal's frosted background shows through.

theme[main_bg]=""

theme[main_fg]="#e6f1ff"
theme[title]="#00f0ff"
theme[hi_fg]="#a855f7"
theme[selected_bg]="#12384a"
theme[selected_fg]="#00f0ff"
theme[inactive_fg]="#2b3f57"
theme[graph_text]="#cfe3f7"
theme[meter_bg]="#111a2b"
theme[proc_misc]="#cfe3f7"

theme[cpu_box]="#a855f7"
theme[mem_box]="#5cf2c5"
theme[net_box]="#ff4d6d"
theme[proc_box]="#00f0ff"
theme[div_line]="#2b3f57"

theme[temp_start]="#5cf2c5"
theme[temp_mid]="#ffd166"
theme[temp_end]="#ff4d6d"

theme[cpu_start]="#00f0ff"
theme[cpu_mid]="#4cc9f0"
theme[cpu_end]="#a855f7"

theme[free_start]="#a855f7"
theme[free_mid]="#4cc9f0"
theme[free_end]="#00f0ff"

theme[cached_start]="#4cc9f0"
theme[cached_mid]="#00f0ff"
theme[cached_end]="#a855f7"

theme[available_start]="#ffd166"
theme[available_mid]="#ff9e64"
theme[available_end]="#ff4d6d"

theme[used_start]="#5cf2c5"
theme[used_mid]="#00f0ff"
theme[used_end]="#4cc9f0"

theme[download_start]="#ffd166"
theme[download_mid]="#ff9e64"
theme[download_end]="#ff4d6d"

theme[upload_start]="#5cf2c5"
theme[upload_mid]="#00f0ff"
theme[upload_end]="#4cc9f0"

theme[process_start]="#00f0ff"
theme[process_mid]="#4cc9f0"
theme[process_end]="#a855f7"

theme[gradient_color_0]="#070b14"
theme[gradient_color_1]="#111a2b"
theme[gradient_color_2]="#12384a"
theme[gradient_color_3]="#2b3f57"
